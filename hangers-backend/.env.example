PORT=5001
NODE_ENV=development
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_UTC_OFFSET=+05:30
IRON_LOG_BACKDATE_DAYS=7

DATABASE_URL="postgresql://postgres:password@localhost:5432/hangers_db"

JWT_SECRET="replace_with_a_long_random_secret"
JWT_CUSTOMER_EXPIRES_IN=30d
JWT_STAFF_EXPIRES_IN=12h

CRM_URL=http://localhost:5002
# Public origin of this backend. Required in production for hosted QR/media URLs.
PUBLIC_API_URL=http://localhost:5001
CUSTOMER_APP_URL=http://localhost:8081
STAFF_APP_URL=http://localhost:8082
# Production must use HTTPS origins only, comma-separated.
# Example: ALLOWED_ORIGINS=https://crm.example.com,https://app.example.com
ALLOWED_ORIGINS=

# Required in production for notification/PDF workers.
REDIS_URL=

DEV_MODE=true
DEV_OUTBOX_WORKER=true
WA_DELIVERY_OTP_DEV=true

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=HNGRS

META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_OTP_TEMPLATE=hangers_otp

WHATOMATE_TEMPLATE_URL=https://whatomate-production-949e.up.railway.app/api/messages/template
WHATOMATE_API_KEY=
WHATOMATE_ACCOUNT_NAME=Hangers
WHATOMATE_SEND_IN_DEV=false
# Comma-separated E.164/Indian numbers that may receive real Whatomate messages in DEV_MODE.
# Keep blank by default. Example local-only value: 919930367267
WHATOMATE_DEV_ALLOWED_PHONES=

RAZORPAY_KEY_ID=
# Only used when key is rzp_test_; checkout fails closed if the approved test contact is absent or incorrect.
RAZORPAY_TEST_CONTACT_NUMBER=
RAZORPAY_KEY_SECRET=
# Optional presentation-only checkout experiment. It is hard-disabled outside Razorpay Test Mode.
RAZORPAY_CHECKOUT_AB_ENABLED=false
# At least 32 random characters; hashes the browser-local experiment ID before persistence.
RAZORPAY_AB_HASH_SECRET=
# Current secret configured for this webhook endpoint in Razorpay Dashboard > Webhooks.
# During rotation only, set PREVIOUS to the old value; never commit actual secrets.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_WEBHOOK_SECRET_TEST=
RAZORPAY_WEBHOOK_SECRET_TEST_PREVIOUS=
RAZORPAY_WEBHOOK_SECRET_LIVE=
RAZORPAY_WEBHOOK_SECRET_LIVE_PREVIOUS=
RAZORPAY_WEBHOOK_CONCURRENCY=4
# Optional daily Finance settlement-report sync (current + previous month by default).
# Enable only after confirming settlements.reports access for this merchant/mode.
ENABLE_RAZORPAY_SETTLEMENT_RECONCILIATION=false
RAZORPAY_SETTLEMENT_RECON_LOOKBACK_MONTHS=2
RAZORPAY_SETTLEMENT_SUMMARY_LOOKBACK_DAYS=30

# Must match the CRM_INGEST_SECRET set on the public-site pickup-intake
# Lambda (infra/public-site/template.yaml) — required for the queued
# pickup-request drain job to authenticate against /pickup-requests/queued-ingest.
PICKUP_QUEUE_INGEST_SECRET=
