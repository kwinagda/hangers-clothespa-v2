# Backend URL — your hangers-backend running on port 5001
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Public pickup-intake API Gateway URL (infra/public-site/template.yaml
# PickupIntakeApiUrl output) — lets the pickup form submit directly to the
# Lambda/SQS queue, independent of whether the CRM backend (EC2) is running.
# Leave blank locally; falls back to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_PICKUP_INTAKE_URL=
